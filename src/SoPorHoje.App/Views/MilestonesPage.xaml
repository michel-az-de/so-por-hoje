<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SoPorHoje.App.ViewModels"
             x:Class="SoPorHoje.App.Views.MilestonesPage"
             x:DataType="vm:MilestonesViewModel"
             Title="Marcos"
             BackgroundColor="{AppThemeBinding Light={StaticResource BgPrimary}, Dark={StaticResource BgPrimaryDark}}"
             SemanticProperties.Description="Tela de Marcos — fichas de tempo de recuperação">

    <ScrollView Style="{StaticResource PageScrollView}">
        <VerticalStackLayout Padding="16,12,16,32" Spacing="0">

            <Label Text="Marcos"
                   Style="{StaticResource PageTitle}"
                   Margin="0,4,0,4"
                   SemanticProperties.HeadingLevel="Level1"
                   SemanticProperties.Description="Marcos" />
            <Label Text="{Binding Summary}"
                   Style="{StaticResource MutedText}"
                   Margin="0,0,0,20"
                   SemanticProperties.Description="{Binding Summary}" />

            <CollectionView ItemsSource="{Binding Milestones}"
                            SelectionMode="None"
                            SemanticProperties.Description="Lista de marcos de tempo">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MilestoneItem">
                        <Frame Style="{StaticResource CardFrame}"
                               Margin="0,0,0,8"
                               Opacity="{Binding Opacity}"
                               SemanticProperties.Description="{Binding Accessibility}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" MinimumHeightRequest="44">
                                <Label Grid.Column="0"
                                       Text="{Binding Emoji}"
                                       FontSize="28"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource BodyText}"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Period}"
                                           Style="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding Status}"
                                       Style="{StaticResource CaptionText}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
