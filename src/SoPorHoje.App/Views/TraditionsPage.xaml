<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SoPorHoje.App.ViewModels"
             xmlns:controls="clr-namespace:SoPorHoje.App.Controls"
             x:Class="SoPorHoje.App.Views.TraditionsPage"
             x:DataType="vm:TraditionsViewModel"
             Title="Combinados"
             BackgroundColor="{AppThemeBinding Light={StaticResource BgPrimary}, Dark={StaticResource BgPrimaryDark}}"
             SemanticProperties.Description="Combinados — acordos comigo mesmo">

    <ScrollView Style="{StaticResource PageScrollView}">
        <VerticalStackLayout Padding="16,12,16,32" Spacing="0">

            <!-- Header -->
            <Label Text="Combinados"
                   Style="{StaticResource PageTitle}"
                   Margin="0,4,0,4"
                   SemanticProperties.HeadingLevel="Level1"
                   SemanticProperties.Description="Combinados" />
            <Label Text="Acordos comigo mesmo, só por hoje"
                   Style="{StaticResource MutedText}"
                   Margin="0,0,0,20"
                   SemanticProperties.Description="Acordos comigo mesmo, só por hoje" />

            <!-- Accordion de Combinados -->
            <CollectionView ItemsSource="{Binding Traditions}"
                            SelectionMode="None"
                            SemanticProperties.Description="Lista de combinados">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TraditionItem">
                        <controls:AccordionItem
                            Number="{Binding Number}"
                            Title="{Binding Title}"
                            Body="{Binding Text}"
                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                            Margin="0,0,0,0" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
